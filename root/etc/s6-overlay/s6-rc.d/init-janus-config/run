#!/usr/bin/with-contenv bash
# shellcheck shell=bash

echo "**** Janus init ****"

# Use the Prisma CLI shipped in the application's node_modules.
export PATH="/app/node_modules/.bin:${PATH}"

# ---------------------------------------------------------------------------
# Choose the run user: PUID/PGID -> LSIO 'abc', otherwise -> www-data.
# ---------------------------------------------------------------------------
if [[ -z ${LSIO_NON_ROOT_USER} ]]; then
    RUN_USER="abc"
    RUN_GROUP="abc"
else
    RUN_USER="www-data"
    RUN_GROUP="www-data"
fi

echo "**** Ensuring /config and /data exist ****"
mkdir -p /config /data

# ---------------------------------------------------------------------------
# Generate .env if not present (idempotent).
# ---------------------------------------------------------------------------
echo "**** Generating .env if not present ****"
if [[ ! -f /config/.env ]]; then
    if [[ -n "${JANUS_ENV:-}" ]]; then
        echo "Writing user-provided .env from JANUS_ENV"
        printf '%s' "${JANUS_ENV}" > /config/.env
    else
        echo "Generating .env from container environment"
        cat > /config/.env <<EOF
PORT=${PORT:-3000}
DB_HOST=${DB_HOST:-}
DB_PORT=${DB_PORT:-3306}
DB_USERNAME=${DB_USERNAME:-}
DB_PASSWORD=${DB_PASSWORD:-}
DB_NAME=${DB_NAME:-}
ISSUER=${ISSUER:-}
BS_SITE_URL=${BS_SITE_URL:-}
SHARED_CLIENT_ID=${SHARED_CLIENT_ID:-}
TOKEN_EXPIRES_IN_1=${TOKEN_EXPIRES_IN_1:-259200}
TOKEN_EXPIRES_IN_2=${TOKEN_EXPIRES_IN_2:-604800}
DEVICE_CODE_EXPIRES_IN=${DEVICE_CODE_EXPIRES_IN:-600}
GRANT_EXPIRES_IN=${GRANT_EXPIRES_IN:-25920000}
DB_CONNECTION_STRING="mysql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"
EOF
    fi
fi

echo "**** Linking .env into the application directory ****"
ln -sfnT /config/.env /app/.env

# ---------------------------------------------------------------------------
# Minimal validation so users get a clear error instead of a NestJS crash.
# ---------------------------------------------------------------------------
echo "**** Validating configuration ****"
# shellcheck disable=SC1091
. /config/.env

if [[ -z "${DB_HOST:-}" || -z "${DB_USERNAME:-}" || -z "${DB_PASSWORD:-}" || -z "${DB_NAME:-}" ]]; then
    echo "ERROR: JANUS requires DB_HOST, DB_USERNAME, DB_PASSWORD and DB_NAME." >&2
    echo "       Set them via environment variables (see README)." >&2
    exit 1
fi

# ISSUER / BS_SITE_URL must be https:// (or http://localhost), with no trailing
# slash, query string or fragment — matching Janus's env validation.
validate_secure_url() {
    local var_name="$1"
    local val="${!var_name}"
    if [[ -z "${val}" ]]; then
        echo "ERROR: ${var_name} is required." >&2
        exit 1
    fi
    if [[ "${val}" != "https://"* && "${val}" != "http://localhost"* && "${val}" != "http://127.0.0.1"* ]]; then
        echo "ERROR: ${var_name} must be an https:// URL (or http://localhost)." >&2
        exit 1
    fi
    if [[ "${val}" == *"/" ]]; then
        echo "ERROR: ${var_name} must not end with a slash." >&2
        exit 1
    fi
}
validate_secure_url ISSUER
validate_secure_url BS_SITE_URL

# ---------------------------------------------------------------------------
# oauth-private.key — copied from Blessing Skin Server's storage/ directory.
# Convert PKCS#1 -> PKCS#8 if necessary.
# ---------------------------------------------------------------------------
echo "**** Handling oauth-private.key ****"
if [[ ! -f /config/oauth-private.key ]]; then
    echo "ERROR: /config/oauth-private.key not found." >&2
    echo "       Copy the file from your Blessing Skin Server's storage/oauth-private.key" >&2
    echo "       into the ./config volume (e.g. ./config/oauth-private.key) before starting." >&2
    exit 1
fi
if grep -q "BEGIN RSA PRIVATE KEY" /config/oauth-private.key; then
    echo "Converting PKCS#1 key to PKCS#8"
    openssl pkcs8 -topk8 -nocrypt -in /config/oauth-private.key -out /app/oauth-private.key
    chmod 600 /app/oauth-private.key
else
    cp -a /config/oauth-private.key /app/oauth-private.key
    chmod 600 /app/oauth-private.key
fi

# ---------------------------------------------------------------------------
# Prisma schema preparation (DB_PREFIX support).
# ---------------------------------------------------------------------------
echo "**** Preparing Prisma schema ****"
if [[ ! -f /app/prisma/schema.prisma ]]; then
    cp /app/prisma/schema.prisma.example /app/prisma/schema.prisma
fi
if [[ -n "${DB_PREFIX:-}" ]]; then
    echo "Applying table prefix '${DB_PREFIX}' to Prisma schema and migrations"
    # Prefix every @@map(...) table mapping. /app is rebuilt fresh from the
    # image on each start, so this is idempotent across restarts.
    sed -ri "s/@@map\(\"([^\"]+)\"\)/@@map(\"${DB_PREFIX}\1\")/g" /app/prisma/schema.prisma
    # Align the yggc_* table names in the migration SQL with the prefix.
    for f in /app/prisma/migrations/*/migration.sql; do
        sed -ri "s/\`yggc_/\`${DB_PREFIX}yggc_/g" "$f"
    done
    echo "Regenerating Prisma client for DB_PREFIX"
    cd /app
    prisma generate
fi

echo "**** Running database migrations ****"
cd /app
# The 0_init migration mirrors the already-existing Blessing Skin tables and
# must NOT be executed; mark it as applied, then deploy the Janus migrations.
prisma migrate resolve --applied 0_init || true
if ! prisma migrate deploy; then
    echo "ERROR: Database migration failed. Check that DB_* points to a reachable" >&2
    echo "       MySQL/MariaDB (the same one used by Blessing Skin Server)." >&2
    exit 1
fi

echo "**** Setting permissions ****"
# /config and /data are writable by the run user. The rest of /app is read-only
# for the app, so only the signing key must be readable by the run user.
lsiown -R "${RUN_USER}:${RUN_GROUP}" /config /data
chown "${RUN_USER}:${RUN_GROUP}" /app/oauth-private.key

echo "**** Janus init complete ****"
