#!/usr/bin/with-contenv bash
# shellcheck shell=bash

echo "**** Janus init ****"

# Use the Prisma CLI shipped in the application's node_modules.
export PATH="/app/node_modules/.bin:${PATH}"

# ---------------------------------------------------------------------------
# Choose the run user: PUID/PGID -> LSIO 'abc', otherwise -> www-data.
# ---------------------------------------------------------------------------
if [[ -z ${LSIO_NON_ROOT_USER} ]]; then
    RUN_USER="abc"
    RUN_GROUP="abc"
else
    RUN_USER="www-data"
    RUN_GROUP="www-data"
fi

# ---------------------------------------------------------------------------
# .env — copy the shipped template, then apply container (docker-compose)
# environment overrides. Precedence (highest first):
#   docker-compose env vars > existing .env > copied .env.example default.
# ---------------------------------------------------------------------------
echo "**** Preparing /config/.env from .env.example ****"
if [[ ! -f /config/.env ]]; then
    cp /app/.env.example /config/.env
fi

apply_env() {
    local key="$1"
    local val="${!key}"
    if [[ -n "${val}" ]]; then
        local esc
        esc=$(printf '%s' "${val}" | sed -e 's/[\\&|]/\\&/g')
        if grep -q "^${key}=" /config/.env; then
            sed -ri "s|^${key}=.*|${key}=${esc}|" /config/.env
        else
            echo "${key}=${val}" >> /config/.env
        fi
    fi
}

apply_env PORT
apply_env DB_HOST
apply_env DB_PORT
apply_env DB_USERNAME
apply_env DB_PASSWORD
apply_env DB_NAME
apply_env DB_PREFIX
apply_env ISSUER
apply_env BS_SITE_URL
apply_env SHARED_CLIENT_ID
apply_env TOKEN_EXPIRES_IN_1
apply_env TOKEN_EXPIRES_IN_2
apply_env DEVICE_CODE_EXPIRES_IN
apply_env GRANT_EXPIRES_IN

echo "**** Linking .env into the application directory ****"
ln -sfnT /config/.env /app/.env

# ---------------------------------------------------------------------------
# oauth-private.key — read from the (read-only) Blessing Skin storage mount.
# Convert PKCS#1 -> PKCS#8 if necessary.
# ---------------------------------------------------------------------------
echo "**** Copying oauth-private.key from Blessing Skin storage ****"
if [[ -f /server-storage/oauth-private.key ]]; then
    if grep -q "BEGIN RSA PRIVATE KEY" /server-storage/oauth-private.key; then
        echo "Converting PKCS#1 key to PKCS#8"
        openssl pkcs8 -topk8 -nocrypt -in /server-storage/oauth-private.key -out /app/oauth-private.key
    else
        cp -a /server-storage/oauth-private.key /app/oauth-private.key
    fi
    chmod 600 /app/oauth-private.key
fi

# ---------------------------------------------------------------------------
# Backup the database BEFORE running any migration.
# ---------------------------------------------------------------------------
echo "**** Backing up database before migration ****"
mkdir -p /data
set -a
. /config/.env
set +a
BACKUP_FILE="/data/backup-$(date +%Y%m%d%H%M%S).sql"
if [[ -n "${DB_HOST:-}" && -n "${DB_NAME:-}" ]]; then
    MYSQL_PWD="${DB_PASSWORD}" mariadb-dump \
        -h"${DB_HOST}" -P"${DB_PORT:-3306}" -u"${DB_USERNAME}" "${DB_NAME}" \
        > "${BACKUP_FILE}" 2>/dev/null
    if [[ -s "${BACKUP_FILE}" ]]; then
        echo "   Backup saved to ${BACKUP_FILE}"
    else
        echo "   WARN: backup may have failed (${BACKUP_FILE})"
    fi
else
    echo "   DB_* not configured; skipping backup (check /config/.env)."
fi

# ---------------------------------------------------------------------------
# Prisma schema preparation (DB_PREFIX support).
# ---------------------------------------------------------------------------
echo "**** Preparing Prisma schema ****"
cp /app/prisma/schema.prisma.example /app/prisma/schema.prisma
if [[ -n "${DB_PREFIX:-}" ]]; then
    echo "Applying table prefix '${DB_PREFIX}' to Prisma schema and migrations"
    sed -ri "s/@@map\(\"([^\"]+)\"\)/@@map(\"${DB_PREFIX}\1\")/g" /app/prisma/schema.prisma
    for f in /app/prisma/migrations/*/migration.sql; do
        sed -ri "s/\`yggc_/\`${DB_PREFIX}yggc_/g" "$f"
    done
    echo "Regenerating Prisma client for DB_PREFIX"
    cd /app
    prisma generate
fi

echo "**** Running database migrations ****"
cd /app
# 0_init mirrors the already-existing Blessing Skin tables; mark it applied,
# then deploy the Janus migrations.
prisma migrate resolve --applied 0_init || true
prisma migrate deploy

echo "**** Setting permissions ****"
lsiown -R "${RUN_USER}:${RUN_GROUP}" \
    /app \
    /config \
    /data

echo "**** Janus init complete ****"
