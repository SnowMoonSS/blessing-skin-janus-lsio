#!/usr/bin/with-contenv bash
# shellcheck shell=bash

echo "**** Janus init ****"

# Use the Prisma CLI shipped in the application's node_modules.
export PATH="/app/node_modules/.bin:${PATH}"

# ---------------------------------------------------------------------------
# Choose the run user: PUID/PGID -> LSIO 'abc', otherwise -> www-data.
# ---------------------------------------------------------------------------
if [[ -z ${LSIO_NON_ROOT_USER} ]]; then
    RUN_USER="abc"
    RUN_GROUP="abc"
else
    RUN_USER="www-data"
    RUN_GROUP="www-data"
fi

# ---------------------------------------------------------------------------
# Generate .env if not present (do not overwrite the persisted config).
# ---------------------------------------------------------------------------
echo "**** Generating .env if not present ****"
if [[ ! -f /config/.env ]]; then
    if [[ -n "${JANUS_ENV:-}" ]]; then
        printf '%s' "${JANUS_ENV}" > /config/.env
    else
        cat > /config/.env <<EOF
PORT=${PORT:-3000}
DB_HOST=${DB_HOST:-}
DB_PORT=${DB_PORT:-3306}
DB_USERNAME=${DB_USERNAME:-}
DB_PASSWORD=${DB_PASSWORD:-}
DB_NAME=${DB_NAME:-}
ISSUER=${ISSUER:-}
BS_SITE_URL=${BS_SITE_URL:-}
SHARED_CLIENT_ID=${SHARED_CLIENT_ID:-}
TOKEN_EXPIRES_IN_1=${TOKEN_EXPIRES_IN_1:-259200}
TOKEN_EXPIRES_IN_2=${TOKEN_EXPIRES_IN_2:-604800}
DEVICE_CODE_EXPIRES_IN=${DEVICE_CODE_EXPIRES_IN:-600}
GRANT_EXPIRES_IN=${GRANT_EXPIRES_IN:-25920000}
DB_CONNECTION_STRING="mysql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"
EOF
    fi
fi

echo "**** Linking .env into the application directory ****"
ln -sfnT /config/.env /app/.env

# ---------------------------------------------------------------------------
# oauth-private.key — copied from Blessing Skin Server's storage/ directory.
# Convert PKCS#1 -> PKCS#8 if necessary. If absent, Janus itself will fail.
# ---------------------------------------------------------------------------
echo "**** Handling oauth-private.key ****"
if [[ -f /config/oauth-private.key ]]; then
    if grep -q "BEGIN RSA PRIVATE KEY" /config/oauth-private.key; then
        echo "Converting PKCS#1 key to PKCS#8"
        openssl pkcs8 -topk8 -nocrypt -in /config/oauth-private.key -out /app/oauth-private.key
    else
        cp -a /config/oauth-private.key /app/oauth-private.key
    fi
    chmod 600 /app/oauth-private.key
fi

# ---------------------------------------------------------------------------
# Prisma schema preparation (DB_PREFIX support).
# ---------------------------------------------------------------------------
echo "**** Preparing Prisma schema ****"
cp /app/prisma/schema.prisma.example /app/prisma/schema.prisma
if [[ -n "${DB_PREFIX:-}" ]]; then
    echo "Applying table prefix '${DB_PREFIX}' to Prisma schema and migrations"
    sed -ri "s/@@map\(\"([^\"]+)\"\)/@@map(\"${DB_PREFIX}\1\")/g" /app/prisma/schema.prisma
    for f in /app/prisma/migrations/*/migration.sql; do
        sed -ri "s/\`yggc_/\`${DB_PREFIX}yggc_/g" "$f"
    done
    echo "Regenerating Prisma client for DB_PREFIX"
    cd /app
    prisma generate
fi

echo "**** Running database migrations ****"
cd /app
# 0_init mirrors the already-existing Blessing Skin tables; mark it applied,
# then deploy the Janus migrations.
prisma migrate resolve --applied 0_init || true
prisma migrate deploy

echo "**** Setting permissions ****"
lsiown -R "${RUN_USER}:${RUN_GROUP}" \
    /app \
    /config \
    /data

echo "**** Janus init complete ****"
